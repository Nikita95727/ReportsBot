# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/openai/deployments/your-deployment
AZURE_OPENAI_API_KEY=your_api_key
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_DEPLOYMENT=gpt-5.4

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=reports_user
MYSQL_PASSWORD=reports_pass
MYSQL_DATABASE=reports_db

# Team members: comma-separated telegram_id:username pairs
# Example: 123456:john,789012:jane
TEAM_MEMBERS=

# Timezone
TIMEZONE=Asia/Almaty
